PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/st_antony_illuppur
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_DOMAIN=http://localhost:3000

S3_BUCKET_NAME=your-church-media-bucket
AWS_REGION=ap-south-1
# Local development credentials; use an IAM role in AWS deployments instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary credentials:
AWS_SESSION_TOKEN=
# Optional CloudFront/media base URL, used only for public/* keys:
S3_PUBLIC_BASE_URL=

# Availability emails: enable after configuring a verified SES sender.
PRIEST_REMINDERS_ENABLED=false
SES_FROM_EMAIL=
# Optional override; otherwise AWS_REGION is used.
SES_REGION=
PRIEST_REMINDER_MINUTES=15
PRIEST_REMINDER_TIMEZONE=Asia/Kolkata
